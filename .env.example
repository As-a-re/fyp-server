# M-CARE backend — environment configuration
#
# This file did not exist anywhere in the uploaded project (PROJECT_FIXES.md
# references it, but it was missing). Rebuilt by scanning every
# process.env.* reference actually used in src/, so nothing here is guessed.
# Copy to .env and fill in real values.

# Server
PORT=5000
NODE_ENV=development

# Supabase (required - server will not boot without these two)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Tavus AI (English conversation path — video avatar)
# Get these from https://app.tavusapi.com. This is the only Tavus config
# actually used anywhere in the codebase (config/tavus.js and
# scripts/syncTavusPersona.js) — the old services/tavusService.js file that
# referenced a different TAVUS_BASE_URL variable was dead code and has been
# removed.
TAVUS_API_KEY=
TAVUS_API_URL=https://tavusapi.com/v2
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=

# Free knowledge-base pipeline (Twi conversation path) — replaces
# CustomGPT.ai. Retrieval runs locally in ml-service (no key needed, see
# ML_SERVICE_URL below). Generation uses Groq's free, no-credit-card API —
# get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# ML Service (risk prediction + knowledge-base retrieval — see ml-service/)
ML_SERVICE_URL=http://localhost:8000
# Optional: protects ml-service's POST /kb/ingest endpoint. Set the same
# value here and as KB_INGEST_TOKEN in the environment ml-service runs in.
KB_INGEST_TOKEN=

# GhanaNLP / Khaya (Twi ASR + TTS, and general translation)
GHANA_BASE_URL=https://translation-api.ghananlp.org
GHANA_API_KEY=
# ASR endpoint version. Set to v3 per current project configuration. Note:
# at the time this was set, only v1 (translate) and v2 (ASR/TTS) endpoints
# were found in GhanaNLP's public documentation — if ASR requests start
# 404ing, this is the first thing to check; override back to "v2" (or
# whatever your subscription actually provides) here without touching code.
GHANA_ASR_VERSION=v3
GHANA_ASR_CONTENT_TYPE=audio/wav
GHANA_API_TIMEOUT_MS=120000

# Azure Translator (used as a fallback/alternate translation provider —
# check services/translator.js for exactly when this path is used vs
# GhanaNLP)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=

# Agora (voice/video calling — controllers/callController.js)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
