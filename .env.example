# Tavus AI Configuration (English conversation path only)
# Get these values from https://app.tavusapi.com
TAVUS_API_KEY=your_real_api_key_here_get_from_dashboard
TAVUS_API_URL=https://tavusapi.com/v2
TAVUS_PERSONA_ID=p_your_persona_id_here
TAVUS_REPLICA_ID=r_your_replica_id_here

# Free knowledge-base pipeline (Twi conversation path) — replaces CustomGPT.ai
# Retrieval runs locally in ml-service (no key needed, see ML_SERVICE_URL
# below). Generation uses Groq's free, no-credit-card API — get a key at
# https://console.groq.com (Free tier: sign up with any email, no company
# domain or trial countdown required).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# ML Service (backend/src/routes/prediction.js calls this for risk
# prediction, and services/ragService.js calls it for knowledge-base
# retrieval — see ml-service/)
ML_SERVICE_URL=http://localhost:8000
# Optional: protects ml-service's POST /kb/ingest endpoint. Set the same
# value here and as KB_INGEST_TOKEN in the environment ml-service runs in.
KB_INGEST_TOKEN=

# GhanaNLP Configuration (Twi ASR + TTS — used by both translation and the
# Twi assistant voice pipeline)
GHANA_BASE_URL=https://translation-api.ghananlp.org
GHANA_API_KEY=your_ghananlp_subscription_key_here
# Current Khaya/GhanaNLP ASR endpoint version. v1 is legacy.
GHANA_ASR_VERSION=v3
# Audio content type sent to the ASR endpoint. The project normalizes uploads to WAV.
GHANA_ASR_CONTENT_TYPE=audio/wav
GHANA_API_TIMEOUT_MS=120000

# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# Optional: Database direct connection (if not using Supabase)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Optional: JWT secret for authentication
JWT_SECRET=your_jwt_secret_here_change_in_production

# Optional: CORS settings
CORS_ORIGIN=http://localhost:3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# IMPORTANT:
# Keep GHANA_API_KEY only on the backend. Never put this key in the Expo app.
# If your Khaya subscription does not include ASR v2, use the ASR version
# included by your subscribed product; the current project defaults to v2.
