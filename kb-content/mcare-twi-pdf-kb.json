    }
  },
  {
    "id": "mcare-twi-pdf-104",
    "content": "Abɔfra a ne ho ayɛ hyew anaa ho ayɛ nwunwunwun (fever/very cold) — Fever or very cold to touch",
    "metadata": {
      "source": "M-CARE_Twi_Knowledge_Base.pdf",
